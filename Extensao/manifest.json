{
  "manifest_version": 3,
  "name": "Assistente Base de Conhecimento",
  "description": "Assistente para consulta à Base de Conhecimento.",
  "version": "1.0.0",

  "action": {
    "default_title": "Assistente Base de Conhecimento"
  },

  "side_panel": {
    "default_path": "pages/sidebar.html"
  },

  "permissions": [
    "sidePanel"
  ]
  ,

  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ]
  ,

"web_accessible_resources": [
  {
    "resources": [
      "base/*",
      "base/**/*"
    ],
    "matches": [
      "<all_urls>"
    ]
  }
]
 
}